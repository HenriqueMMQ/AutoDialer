<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Call Queue"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="⚙ Settings"
            android:textSize="13sp"
            android:backgroundTint="#757575" />
    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Load an Excel file to start"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnLoad"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Load Excel"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnDial"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Dial Next"
            android:backgroundTint="#2E7D32"
            android:enabled="false" />
    </LinearLayout>

    <Button
        android:id="@+id/btnReload"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Reload Last File"
        android:backgroundTint="#1565C0"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnBrowseFolder"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Browse DialerApp Folder"
        android:backgroundTint="#6A1B9A"
        android:layout_marginBottom="8dp" />

    <CheckBox
        android:id="@+id/checkAutoCall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Auto-call next after disposition"
        android:textSize="14sp"
        android:layout_marginBottom="12dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
